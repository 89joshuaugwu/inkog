rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin helper ─────────────────────────────────────────
    // Update this to match your NEXT_PUBLIC_ADMIN_EMAIL value
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
             "joshuazaza89@gmail.com",
             "admin@inkognito.com"
           ];
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {

      // Anyone can read profiles (needed for public /u/[username])
      allow read: if true;

      // Only the authenticated owner can create their profile
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;

      // Only the authenticated owner can update
      // Cannot change uid, email, or createdAt
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && (
                      (resource.data.username == "" && request.resource.data.username is string)
                      ||
                      request.resource.data.username == resource.data.username
                    );

      // Admin can delete users (for admin dashboard)
      allow delete: if isAdmin();
    }

    // ============================================
    // USERNAMES COLLECTION
    // ============================================
    match /usernames/{username} {

      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20;

      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // MESSAGES COLLECTION
    // ============================================
    match /messages/{messageId} {

      // ── FIX: Split read into get + list ──────────────────
      // get = single document read (resource.data IS available)
      // list = query / aggregation (resource.data is NULL — cannot use it)

      // Single document read: recipient or admin
      allow get: if request.auth != null
                 && (resource.data.recipientId == request.auth.uid
                     || isAdmin());

      // List / aggregation (getCountFromServer, queries): admin only
      // resource.data is NOT available here — do NOT reference it
      allow list: if isAdmin();

      // Anyone can send a message (anonymous messaging core feature)
      allow create: if request.resource.data.keys().hasAll([
                         "content", "recipientId", "recipientUsername", "createdAt"
                       ])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 1
                    && request.resource.data.content.size() <= 500
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientUsername is string
                    && request.resource.data.keys().size() >= 4
                    && request.resource.data.keys().size() <= 6;

      // Recipient or admin can delete
      allow delete: if request.auth != null
                    && (resource.data.recipientId == request.auth.uid
                        || isAdmin());

      // Recipient can update reaction only
      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reaction"]);
    }

    // ============================================
    // CATCH-ALL: Deny everything else
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}